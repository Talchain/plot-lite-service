{
  "name": "@olumi/plot-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for PLoT Engine API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "pack": "npm pack"
  },
  "keywords": ["plot", "causal", "inference", "sdk"],
  "author": "Olumi",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
