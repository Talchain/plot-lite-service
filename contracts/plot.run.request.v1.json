{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plot.talchain.com/schemas/plot.run.request.v1.json",
  "title": "PLoT Engine Run Request v1",
  "description": "Request schema for POST /v1/run with strict validation",
  "type": "object",
  "required": ["graph", "outcome_node"],
  "additionalProperties": false,
  "properties": {
    "graph": {
      "type": "object",
      "description": "Directed acyclic graph structure",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": true,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number"
              },
              "belief": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "outcome_node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Target node for outcome measurement"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Random seed for deterministic runs"
    },
    "k_samples": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000,
      "description": "Number of Monte Carlo samples"
    },
    "treatment_node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Treatment/intervention node"
    },
    "baseline_value": {
      "type": "number",
      "description": "Baseline value for outcome"
    }
  }
}
