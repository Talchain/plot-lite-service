{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plot.talchain.com/schemas/scm.v1.json",
  "title": "Structural Causal Model v1 (DAG only seam)",
  "type": "object",
  "required": ["dag"],
  "properties": {
    "dag": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [{ "type": "string" }, { "type": "string" }]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
