{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olumi.ai/schemas/isl-request.schema.json",
  "title": "ISL Request",
  "description": "Request schema for ISL /api/v1/robustness/analyze/v2 endpoint",
  "type": "object",
  "additionalProperties": true,
  "required": ["graph", "options", "goal_node_id"],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "graph": {
      "type": "object",
      "additionalProperties": true,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": ["decision", "option", "factor", "outcome", "goal", "risk", "constraint"]
              },
              "label": {
                "type": "string"
              },
              "observed_state": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "baseline": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "std": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "exists_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "strength": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "std": {
                    "type": "number"
                  }
                }
              },
              "weight": {
                "type": "number"
              },
              "belief_exists": {
                "type": "number"
              },
              "belief_strength": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "interventions": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "goal_node_id": {
      "type": "string"
    },
    "n_samples": {
      "type": "integer",
      "minimum": 1
    },
    "analysis_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["comparison", "sensitivity", "robustness"]
      }
    },
    "parameter_uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "node_id": {
            "type": "string"
          },
          "distribution": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
