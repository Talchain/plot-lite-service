{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olumi.ai/schemas/plot-response.schema.json",
  "title": "PLoT Response",
  "description": "Response schema for PLoT /v2/run endpoint",
  "type": "object",
  "additionalProperties": true,
  "required": ["option_comparison", "robustness", "factor_sensitivity"],
  "properties": {
    "request_schema_version": {
      "type": "string"
    },
    "endpoint_version": {
      "type": "string"
    },
    "preflight_version": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string"
    },
    "option_comparison_status": {
      "type": "string"
    },
    "robustness_status": {
      "type": "string"
    },
    "drivers_status": {
      "type": "string"
    },
    "isl_analysis_status": {
      "type": "string"
    },
    "cee_status": {
      "type": "string"
    },
    "option_comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["option_id", "win_probability", "outcome"],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "option_label": {
            "type": "string"
          },
          "win_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expected_outcome": {
            "type": "number"
          },
          "confidence_interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "outcome": {
            "type": "object",
            "additionalProperties": true,
            "required": ["mean"],
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number"
              },
              "p10": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p90": {
                "type": "number"
              },
              "n_samples": {
                "type": "integer"
              },
              "n_valid_samples": {
                "type": "integer"
              },
              "validity_ratio": {
                "type": "number"
              }
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["recommendation_stability", "fragile_edges"],
      "properties": {
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "recommendation_stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fragile_edges": {
          "type": "array",
          "description": "Edges sensitive to uncertainty. marginal_switch_probability is optional (defaults to 0 when omitted)",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["edge_id", "switch_probability"],
            "properties": {
              "edge_id": {
                "type": "string"
              },
              "from_id": {
                "type": "string"
              },
              "to_id": {
                "type": "string"
              },
              "switch_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "marginal_switch_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alternative_winner_id": {
                "type": ["string", "null"]
              },
              "alternative_winner_label": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "robust_edges": {
          "type": "array",
          "items": {
            "type": ["string", "object"]
          }
        },
        "explanation": {
          "type": ["string", "null"]
        },
        "is_robust": {
          "type": "boolean",
          "description": "Boolean robustness flag from ISL V2/Option C format"
        },
        "level": {
          "type": "string",
          "enum": ["high", "medium", "low", "very_low"],
          "description": "Robustness level from ISL V2/Option C format"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Robustness confidence from ISL (0-1) V2/Option C format"
        }
      }
    },
    "factor_sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["factor_id", "flip_risk_category"],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "factor_label": {
            "type": "string"
          },
          "influence_score": {
            "type": "number"
          },
          "influence_rank": {
            "type": "integer"
          },
          "sensitivity_score": {
            "type": "number"
          },
          "elasticity": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "mixed"]
          },
          "importance_rank": {
            "type": "integer"
          },
          "value_of_information": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string"
          },
          "flip_risk_category": {
            "type": "string",
            "enum": ["isolated", "correlated", "negligible"]
          },
          "zero_reason": {
            "type": "string"
          }
        }
      }
    },
    "edge_sensitivity": {
      "type": "array"
    },
    "critiques": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "robustness_synthesis": {
      "type": ["object", "null"]
    },
    "decision_quality": {
      "type": ["object", "null"]
    },
    "insights": {
      "type": ["object", "array", "null"]
    },
    "improvement_guidance": {
      "type": ["object", "null"]
    },
    "rationale": {
      "type": ["string", "null"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seed_used": {
          "type": "string"
        },
        "n_samples": {
          "type": "integer"
        },
        "detail_level": {
          "type": "string"
        },
        "latency_ms": {
          "type": "number"
        },
        "build": {
          "type": "string"
        }
      }
    }
  }
}
