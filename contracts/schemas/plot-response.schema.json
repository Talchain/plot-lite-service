{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olumi.ai/schemas/plot-response.schema.json",
  "title": "PLoT Response",
  "description": "Response schema for PLoT /v2/run endpoint",
  "type": "object",
  "additionalProperties": true,
  "required": ["option_comparison", "robustness", "factor_sensitivity"],
  "properties": {
    "request_schema_version": {
      "type": "string"
    },
    "endpoint_version": {
      "type": "string"
    },
    "preflight_version": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string"
    },
    "option_comparison_status": {
      "type": "string"
    },
    "robustness_status": {
      "type": "string"
    },
    "drivers_status": {
      "type": "string"
    },
    "isl_analysis_status": {
      "type": "string"
    },
    "cee_status": {
      "type": "string"
    },
    "option_comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["option_id", "win_probability", "outcome"],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "option_label": {
            "type": "string"
          },
          "win_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expected_outcome": {
            "type": "number"
          },
          "confidence_interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "outcome": {
            "type": "object",
            "additionalProperties": true,
            "required": ["mean"],
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number"
              },
              "p10": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p90": {
                "type": "number"
              },
              "n_samples": {
                "type": "integer"
              },
              "n_valid_samples": {
                "type": "integer"
              },
              "validity_ratio": {
                "type": "number"
              }
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fragile_edges"],
      "properties": {
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "recommendation_stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "DEPRECATED — no longer emitted (2026-07-07): ISL derives it as the leader's win_probability relabelled (option_wins[winner]/n_samples), zero independent information. Kept for inbound tolerance of old payloads only."
        },
        "fragile_edges": {
          "type": "array",
          "description": "Edges sensitive to uncertainty. marginal_switch_probability is optional (defaults to 0 when omitted)",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["edge_id", "switch_probability"],
            "properties": {
              "edge_id": {
                "type": "string"
              },
              "from_id": {
                "type": "string"
              },
              "to_id": {
                "type": "string"
              },
              "switch_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "marginal_switch_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alternative_winner_id": {
                "type": ["string", "null"]
              },
              "alternative_winner_label": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "robust_edges": {
          "type": "array",
          "items": {
            "type": ["string", "object"]
          }
        },
        "explanation": {
          "type": ["string", "null"]
        },
        "is_robust": {
          "type": "boolean",
          "description": "Boolean robustness flag from ISL V2/Option C format"
        },
        "level": {
          "type": "string",
          "enum": ["high", "medium", "low", "very_low"],
          "description": "Robustness level from ISL V2/Option C format"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Robustness confidence from ISL (0-1) V2/Option C format"
        },
        "recommended_option_id": {
          "type": "string",
          "description": "Recommended option ID derived from argmax(win_probability). Tie-breaker: lexicographic sort on option_id when within epsilon (1e-9)."
        },
        "recommended_option_label": {
          "type": "string",
          "description": "Human-readable label for the recommended option. Fallback chain: graph node label → option_comparison label → option_id."
        },
        "near_tie": {
          "type": "object",
          "description": "Near-tie detection when top options are statistically equivalent. Gap < 10% threshold indicates recommendation is uncertain.",
          "additionalProperties": false,
          "required": ["is_tie", "top_option_id", "second_option_id", "tied_option_ids", "gap", "threshold"],
          "properties": {
            "is_tie": {
              "type": "boolean",
              "description": "Whether a near-tie was detected (gap < threshold)"
            },
            "top_option_id": {
              "type": "string",
              "description": "ID of top-performing option (highest win_probability)"
            },
            "second_option_id": {
              "type": ["string", "null"],
              "description": "ID of second-place option (null if only one computed option)"
            },
            "tied_option_ids": {
              "type": "array",
              "items": { "type": "string" },
              "description": "IDs of all options within threshold of top performer"
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Gap between top two options (0-1 probability)"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Threshold used for detection (default: 0.10)"
            }
          }
        }
      }
    },
    "factor_sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["factor_id", "flip_risk_category"],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "factor_label": {
            "type": "string"
          },
          "influence_score": {
            "type": "number"
          },
          "influence_rank": {
            "type": "integer"
          },
          "sensitivity_score": {
            "type": "number"
          },
          "elasticity": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "mixed"]
          },
          "importance_rank": {
            "type": "integer"
          },
          "value_of_information": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evpi_percentage_points": {
            "type": "number",
            "minimum": 0,
            "description": "Estimated EVPI in percentage points of win probability. Source disclosed by evpi_method: 'counterfactual' = ISL per-factor counterfactual EVPI (sanitised; negatives never emitted), 'heuristic' = VOI × win prob spread × 100 (fallback)"
          },
          "evpi_method": {
            "type": "string",
            "enum": ["heuristic", "counterfactual"],
            "description": "Method used to compute evpi_percentage_points"
          },
          "evpi_status": {
            "type": "string",
            "enum": ["below_resolution"],
            "description": "Present only when ISL's counterfactual EVPI estimate for this factor is too small to measure at the run's sampling depth (includes Monte Carlo–noise negatives). evpi_percentage_points is deliberately absent in that case — labelled, never a clamped 0"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_components": {
            "type": "object",
            "additionalProperties": true,
            "description": "Progressive disclosure: the raw components behind `confidence`. Emitted by src/lib/factor-influence.ts. Documented here so the numeric-egress coercion gate's derived field vocabulary covers these names — an absent component must be OMITTED, never substituted with a plausible literal.",
            "properties": {
              "structural_certainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Mean `exists_probability` across the factor's incoming edges. A measurement about graph structure, not a prior: when it was never computed the key must be absent, never a fabricated 0.5 (which asserts 50% certainty for a factor with no incoming edges)."
              },
              "sampling_stability": {
                "type": ["number", "null"],
                "description": "Band score derived from ISL `attribution_stability`. Explicitly `null` when no ISL data was available at this stage — a declared absence, distinct from an unmeasured value."
              }
            }
          },
          "source": {
            "type": "string"
          },
          "flip_risk_category": {
            "type": "string",
            "enum": ["isolated", "correlated", "negligible"]
          },
          "zero_reason": {
            "type": "string"
          },
          "value_source": {
            "type": "string",
            "description": "Track S: provenance of this factor's input value (ISL FactorSensitivityV2 passthrough). Distinct from `source` (producing engine). Absent on older ISL responses."
          },
          "value_extraction_type": {
            "type": "string",
            "description": "Track S: how the factor value was extracted/derived (ISL passthrough). Absent on older ISL responses."
          },
          "value_defaulted": {
            "type": "boolean",
            "description": "Track S: true when ISL substituted a default for the factor value. Absent means not reported / older ISL response; never coerced to false."
          }
        }
      }
    },
    "factor_enrichments": {
      "type": "array",
      "description": "Factor enrichments from CEE /assist/v1/review. Human-readable insights for UI factor cards. Non-deterministic (LLM-derived), excluded from canonical hash.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor_id", "factor_label", "observations", "perspectives"],
        "properties": {
          "factor_id": {
            "type": "string",
            "description": "Factor ID matching factor_sensitivity[].factor_id"
          },
          "factor_label": {
            "type": "string",
            "description": "Human-readable factor label"
          },
          "observations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Key observations about this factor's influence"
          },
          "perspectives": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Alternative perspectives to consider"
          },
          "confidence_question": {
            "type": "string",
            "description": "Optional question to prompt user confidence calibration"
          }
        }
      }
    },
    "m1_coaching": {
      "type": "object",
      "description": "M1 Core Coaching output (Phase 2). Deterministic coaching layer providing story headlines, evidence gaps, model critiques, and next actions. Excluded from response_hash as non-semantic metadata.",
      "additionalProperties": false,
      "required": ["story_headlines", "evidence_gaps", "model_critiques", "next_actions", "readiness", "headline_type", "coaching_version", "computed_at"],
      "properties": {
        "story_headlines": {
          "type": "object",
          "description": "Map of option IDs to one-line headline summaries",
          "additionalProperties": { "type": "string" }
        },
        "evidence_gaps": {
          "type": "array",
          "description": "Top background-uncertainty factors where gathering evidence would most reduce decision uncertainty (capped at 3). Excludes factors that are decision levers (i.e. any factor present in `options[i].interventions` keys); levers may be surfaced separately in a future `option_assumptions` bucket. The `confidence` and `influence` values published here are sourced from the same PLoT-recomputed signals used for the public `factor_sensitivity[]` array (plot_unified_v2 confidence; graph-merged `influence_score`) — never raw ISL `confidence` or `elasticity`.",
          "items": {
            "type": "object",
            "required": ["factor_id", "factor_label", "voi_score", "confidence", "influence"],
            "properties": {
              "factor_id": { "type": "string" },
              "factor_label": { "type": "string" },
              "voi_score": { "type": "number" },
              "confidence": { "type": "number" },
              "confidence_display": { "type": "string" },
              "confidence_defaulted": { "type": "boolean" },
              "influence": { "type": "number" },
              "influence_display": { "type": "string" },
              "suggestion": { "type": "string" },
              "notes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "value": { "type": "number", "description": "Normalised factor value (0-1)" },
              "raw_value": { "type": "number", "description": "Original unscaled value for UI display" },
              "unit": { "type": "string", "description": "Factor unit (e.g. USD, users)" },
              "cap": { "type": "number", "description": "Normalisation scale cap" },
              "evpi_percentage_points": { "type": "number", "minimum": 0, "description": "Estimated EVPI in percentage points of win probability" },
              "evpi_method": { "type": "string", "enum": ["heuristic", "counterfactual"], "description": "Method used to compute evpi_percentage_points" }
            }
          }
        },
        "model_critiques": {
          "type": "array",
          "description": "Structural issues that may affect decision quality",
          "items": {
            "type": "object",
            "required": ["type", "severity", "challenge_question", "suggested_action"],
            "properties": {
              "type": { "type": "string" },
              "severity": { "type": "string", "enum": ["warning", "concern"] },
              "challenge_question": { "type": "string" },
              "suggested_action": { "type": "string" },
              "targets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "context": { "type": "object" }
            }
          }
        },
        "next_actions": {
          "type": "array",
          "description": "Prioritized action list (max 3) with required rationales",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["priority", "action", "rationale"],
            "properties": {
              "priority": { "type": "number" },
              "action": { "type": "string" },
              "rationale": { "type": "string" },
              "related_critique": { "type": "string" }
            }
          }
        },
        "readiness": {
          "type": "string",
          "enum": ["ready", "close_call", "needs_evidence", "needs_framing"]
        },
        "headline_type": {
          "type": "string",
          "enum": ["clear_winner", "moderate_winner", "close_call", "high_uncertainty", "needs_evidence"]
        },
        "top_fragile_edge": {
          "type": "object",
          "properties": {
            "edge_id": { "type": "string" },
            "label": { "type": "string" },
            "alternative_winner": { "type": "string" },
            "switch_probability": { "type": "number" }
          }
        },
        "readiness_tone": {
          "type": "string",
          "enum": ["confident", "tempered", "caution"],
          "description": "Broader action-readiness tone derived from robustness (isRobust + level), recommendation stability, fragile-edge switch probability, evidence-gap count/VOI, top-driver confidence, and near-tie margin. Recommended source for user-facing readiness tiering. Distinct from the legacy `readiness` field, which is a narrower model-readiness signal that continues to drive `confidence_tier`. Optional: (1) for backwards compatibility with consumers built against coaching_version <= 1.1.0, and (2) wrapped in the shared `safeCompute` graceful-degradation pattern — absent only when the classifier itself genuinely throws (rare; the rest of `m1_coaching` still emits)."
        },
        "readiness_reasons": {
          "type": "array",
          "description": "Deterministic reason codes underlying `readiness_tone`. Empty when tone is `confident`. Stable additive vocabulary. Optional for the same reasons as `readiness_tone` — backwards compatibility with coaching_version <= 1.1.0 consumers and absent only when the classifier itself genuinely throws via the shared safeCompute graceful-degradation path.",
          "items": {
            "type": "string",
            "enum": [
              "NOT_ROBUST",
              "LOW_ROBUSTNESS",
              "LOW_STABILITY",
              "MATERIAL_FRAGILE_EDGE",
              "EVIDENCE_GAPS",
              "LOW_DRIVER_CONFIDENCE",
              "NEAR_TIE",
              "INSUFFICIENT_SIGNALS"
            ]
          }
        },
        "coaching_version": { "type": "string" },
        "computed_at": { "type": "string", "format": "date-time" }
      }
    },
    "edge_sensitivity": {
      "type": "array"
    },
    "critiques": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "robustness_synthesis": {
      "type": ["object", "null"]
    },
    "decision_quality": {
      "type": ["object", "null"]
    },
    "insights": {
      "type": ["object", "array", "null"]
    },
    "improvement_guidance": {
      "type": ["object", "null"]
    },
    "rationale": {
      "type": ["string", "null"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seed_used": {
          "type": "string"
        },
        "n_samples": {
          "type": "integer"
        },
        "detail_level": {
          "type": "string"
        },
        "latency_ms": {
          "type": "number"
        },
        "build": {
          "type": "string"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when analysis computation completed. Captured when ISL response is received."
        }
      }
    }
  }
}
