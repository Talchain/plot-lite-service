{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olumi.io/schemas/report.v1.schema.json",
  "title": "Olumi Report v1",
  "description": "Schema for Olumi decision report outputs with KPI percentiles and confidence scoring",
  "type": "object",
  "properties": {
    "schema": {
      "const": "report.v1",
      "description": "Schema version identifier"
    },
    "meta": {
      "type": "object",
      "description": "Metadata about report generation",
      "properties": {
        "seed": {
          "type": "integer",
          "description": "Random seed used for deterministic generation"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of report generation"
        }
      },
      "required": [
        "seed"
      ]
    },
    "summary": {
      "type": "object",
      "description": "Summary of recommendation",
      "properties": {
        "option_best": {
          "type": "string",
          "minLength": 1,
          "description": "Best recommended option (non-empty string)"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "description": "Confidence level of recommendation"
        }
      },
      "required": [
        "option_best"
      ]
    },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "description": "Key performance indicators with percentile distributions",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "KPI name identifier"
          },
          "p10": {
            "type": "number",
            "description": "10th percentile value"
          },
          "p50": {
            "type": "number",
            "description": "50th percentile (median) value"
          },
          "p90": {
            "type": "number",
            "description": "90th percentile value"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement (optional)"
          }
        },
        "required": [
          "name",
          "p10",
          "p50",
          "p90"
        ],
        "additionalProperties": false
      }
    },
    "model_averaging": {
      "type": "object",
      "description": "Bayesian Model Averaging results",
      "properties": {
        "bma_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of BMA computation"
        },
        "K_evaluated": {
          "type": "integer",
          "minimum": 1,
          "description": "Total DAGs evaluated"
        },
        "K_used": {
          "type": "integer",
          "minimum": 1,
          "description": "DAGs used in averaging"
        },
        "mass_covered": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cumulative posterior mass"
        },
        "action_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Consistency of recommended action"
        },
        "sign_flip_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rate of sign flips across models"
        }
      },
      "required": [
        "bma_hash",
        "K_evaluated",
        "K_used",
        "mass_covered"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "stability": {
          "type": "object",
          "properties": {
            "variance_ratio": {
              "type": "number",
              "minimum": 0
            },
            "cv": {
              "type": "number",
              "minimum": 0,
              "description": "Coefficient of variation"
            },
            "stable": {
              "type": "boolean"
            }
          },
          "required": [
            "stable"
          ]
        }
      },
      "required": [
        "level",
        "stability"
      ]
    },
    "identifiability": {
      "type": "object",
      "properties": {
        "identifiable": {
          "type": "boolean"
        },
        "adjustment_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backdoor_satisfied": {
          "type": "boolean"
        }
      },
      "required": [
        "identifiable"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "set",
              "delta"
            ]
          },
          "node": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "relative_to": {
            "type": "string",
            "description": "Reference for delta actions"
          }
        },
        "required": [
          "action_id",
          "type",
          "node",
          "value"
        ]
      }
    },
    "reward": {
      "type": "object",
      "properties": {
        "best_action": {
          "type": "string"
        },
        "regret": {
          "type": "number",
          "minimum": 0
        },
        "top_k": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string"
              },
              "expected_reward": {
                "type": "number"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action_id",
              "expected_reward",
              "rank"
            ]
          }
        }
      },
      "required": [
        "best_action",
        "top_k"
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "inference_ms": {
          "type": "number",
          "minimum": 0
        },
        "bma_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "nodes_source": {
          "type": "string",
          "enum": [
            "human",
            "llm",
            "auto"
          ]
        },
        "edges_source": {
          "type": "string",
          "enum": [
            "human",
            "llm",
            "auto"
          ]
        },
        "human_count": {
          "type": "integer",
          "minimum": 0
        },
        "llm_count": {
          "type": "integer",
          "minimum": 0
        },
        "auto_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "model_card": {
      "type": "object",
      "properties": {
        "response_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "response_hash"
      ]
    }
  },
  "required": [
    "schema",
    "meta",
    "summary",
    "kpis",
    "model_card"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "schema": "report.v1",
      "meta": {
        "seed": 123456,
        "generated_at": "2025-01-01T00:00:00Z"
      },
      "summary": {
        "option_best": "Raise price 10%",
        "confidence": "MEDIUM"
      },
      "kpis": [
        {
          "name": "Revenue",
          "p10": 1.02,
          "p50": 1.06,
          "p90": 1.11,
          "unit": "×"
        },
        {
          "name": "Volume",
          "p10": 0.88,
          "p50": 0.92,
          "p90": 0.96,
          "unit": "×"
        }
      ]
    }
  ],
  "$comment": "Semantic constraint not expressible in JSON Schema: KPI percentiles must be monotonic (p10 ≤ p50 ≤ p90). This is validated by @olumi/report-validate."
}