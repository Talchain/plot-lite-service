{
  "name": "plot-lite-service",
  "version": "1.5.0",
  "description": "Lightweight causal inference engine with trust signals, optional ISL/CEE integration",
  "author": "Olumi",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:local": "tsx watch --env-file=.env.local src/main.ts",
    "build": "npx tsc -p tsconfig.json && npx tsc -p tsconfig.tools.json && bash scripts/check-no-stale-js.sh --clean",
    "start": "node dist/main.js",
    "test": "node tools/run-all-tests.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:engine": "node tools/run-tests.cjs",
    "test:gates": "npx vitest run tests/gates/",
    "test:contracts": "npm run build && npx vitest run tests/contracts.*.test.ts",
    "validate:contracts": "npx tsx contracts/validate.ts",
    "test:stream": "npm run build && npx vitest run tests/stream.*.test.ts",
    "test:security": "npm run build && npx vitest run tests/security.*.test.ts",
    "test:perf": "npm run build && npx vitest run tests/perf.*.test.ts tests/limited-event.test.ts && node tools/run-perf-lane.cjs",
    "mock": "node scripts/mock-server.js",
    "sdk:node:example": "node sdk/node/example.js",
    "ci": "npm ci && npm run build && npm test",
    "replay": "node tools/replay-fixtures.js",
    "stream:replay": "node tools/replay-stream.mjs",
    "loadcheck": "node tools/loadcheck.js",
    "report:compare": "node tools/report-compare.cjs",
    "bench:fanout": "node tools/bench-fanout.cjs",
    "report:lock": "bash tools/report-lock.sh",
    "openapi:lint": "spectral lint contracts/openapi.yaml --ruleset tools/spectral.rules.yaml",
    "spec:lint": "spectral lint contracts/openapi.yaml --ruleset tools/spectral.rules.yaml",
    "test:openapi": "npm run openapi:lint",
    "test:spec": "npm run spec:lint && npx vitest run tests/openapi.dev-route.test.ts",
    "tools:soak": "node tools/soak.mjs",
    "tools:replay": "node tools/replay.mjs --file fixtures/golden-seed-4242/stream.ndjson",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "prepare": "husky install",
    "lint": "eslint src tests --ext .ts --max-warnings 0",
    "lint:strict": "tsc -p tsconfig.strict.json",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "selfcheck:refresh": "npm run build && node scripts/selfcheck-refresh.mjs",
    "audit:prod": "npm audit --production",
    "pr:verify": "node tools/ci/pr-verify.cjs",
    "pack:locate": "node tools/pack-locate.mjs",
    "diag": "bash tools/diag.sh",
    "test:tools-harness": "tsx tests_adapters/tools.replay.harness.ts && tsx tests_adapters/tools.soak.harness.ts",
    "dev:poc": "bash scripts/dev-poc-engine.sh",
    "openapi:render": "node tools/openapi-render.mjs",
    "accept:poc": "node -e \"fetch('http://127.0.0.1:4311/health').then(r=>r.json()).then(j=>console.log('ENGINE_HEALTH:',JSON.stringify(j))).catch(e=>{console.error(e);process.exit(1)})\"",
    "gates": "node tools/run-all-gates.mjs",
    "gates:all": "node tools/run-all-gates.mjs",
    "gate:contract": "node tools/contract-drift-gate.mjs",
    "gate:slo": "node tools/slo-budget-gate.mjs",
    "gate:numeric-egress": "node tools/numeric-egress-gate.mjs",
    "bootstrap:p0-1": "node tools/bootstrap-p0-1.mjs",
    "bootstrap:e2e": "node tools/bootstrap-e2e-all.mjs",
    "e2e": "tsx e2e/run-e2e.mjs || node e2e/run-e2e.mjs",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:logs": "docker compose -f docker-compose.e2e.yml logs -f plot-engine",
    "gate:privacy": "node tools/privacy-gate.mjs",
    "perf:collect": "node tools/perf-collect.mjs",
    "pack:engine": "node tools/pack-engine.mjs",
    "bench:rollout": "node tools/rollout-bench.mjs",
    "dev:engine": "node tools/dev-shell.mjs",
    "smoke:staging": "node tools/smoke.mjs",
    "check:sources": "node tools/ci-check-sources.mjs",
    "check:no-stale-js": "bash scripts/check-no-stale-js.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=20.3.0 <21",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@olumi/assistants-sdk": "^1.11.1",
    "@talchain/schemas": "file:./vendor/talchain-schemas-0.52.0.tgz",
    "ajv": "^8.17.1",
    "fastify": "^5.8.1",
    "fastify-plugin": "^5.1.0",
    "pino": "^9.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.39.1",
    "@redocly/cli": "2.48.0",
    "@stoplight/spectral-cli": "^6.11.1",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^3.2.4",
    "adm-zip": "^0.5.16",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.1",
    "fast-check": "^3.18.0",
    "husky": "^9.1.6",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "fast-uri@3": "3.1.4",
    "fast-uri@4": "4.1.1",
    "find-my-way@9": "9.7.0"
  }
}
