# PLoT Engine Environment Configuration
# Copy this file to .env and customize for your environment

# Server
PORT=4311
HOST=0.0.0.0
NODE_ENV=development

# Authentication (optional)
AUTH_ENABLED=0
AUTH_TOKEN=your-secret-token-here

# Rate Limiting
RATE_LIMIT_ENABLED=1
RATE_LIMIT_RPM=60
MAX_RATE_KEYS=1000

# SSE Streaming
STREAM_HEARTBEAT_SEC=25
STREAM_FORCE_LIMIT=0

# Idempotency
IDEMPOTENCY_TTL_MS=900000

# OpenAPI
OPENAPI_DEV=0
OPENAPI_SPEC_PATH=contracts/openapi.yaml

# Features
TEST_ROUTES=0
METRICS=0
FEATURE_STREAM=0

# SCM-Lite (Structural Causal Model)
SCM_LITE_ENABLE=0
SCM_LITE_K=256
SCM_LITE_MAX_NODES=12
SCM_LITE_BELIEF_DEFAULT=0.7

# Trust Proxy (for X-Forwarded-* headers)
TRUST_PROXY=0

# Logging
LOG_LEVEL=info

# Build/Deploy
ENVIRONMENT=development
BUILD_ID_SHORT=local
